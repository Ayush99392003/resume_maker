# ==============================================================================
# AI LaTeX Resume Maker - Production Environment Configuration (.env.production)
# Target: Single High-Spec VM for 100 Concurrent Users (8-16 vCPU, 16-32 GB RAM)
# ==============================================================================

# --- System & Environment ---
ENVIRONMENT=production
PORT=8001
LOG_LEVEL=INFO
LOG_RICH=0
LOG_LOCALS=0

# --- Worker & Concurrency Scaling ---
# Rule of thumb for 8 vCPU: 4 to 8 workers
GUNICORN_WORKERS=4
# Max concurrent Tectonic compiler subprocesses (tuned to leave headroom for OS & API)
MAX_CONCURRENT_COMPILES=6

# --- PDF Compilation Caching ---
# Caches compiled PDF by SHA-256 hash of LaTeX code (cuts compile latency from 2000ms to <10ms)
PDF_CACHE_ENABLED=1

# --- Security & Session Persistence ---
# Generate a secure 64-character hex secret: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_KEY
REQUIRE_AUTH_FOR_SESSIONS=true

# --- Redis Configuration ---
REDIS_URL=redis://redis:6379/0

# --- LLM Provider Selection & Routing ---
# Default provider and model for resume generation and agentic orchestration
LLM_PROVIDER=groq
MODEL_NAME=openai/gpt-oss-120b

# --- Provider API Keys (Set at least one primary and one fallback) ---
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Azure OpenAI (Optional) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-02-01

# --- AWS Bedrock (Optional) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=
